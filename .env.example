# The Supabase project the app talks to. Both values are safe to publish: the
# publishable key only gets what row-level security allows, which for anyone
# not signed in with an invited account is nothing.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Set when the site is served from a sub-path, e.g. GitHub Pages at
# jdaines89.github.io/scrumline.
NEXT_PUBLIC_BASE_PATH=

# The unions' official badges are trademarks, so teams show as jersey colours
# with initials. Set to 1 only once there is a licence to use the badges.
NEXT_PUBLIC_SHOW_OFFICIAL_LOGOS=
